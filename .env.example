# Copy to .env for local development. Do not commit .env.
#
# Public form endpoint (Formspree or compatible). Example: https://formspree.io/f/abcdwxyz
# This value is not a secret: it is visible in the page HTML by design.
PUBLIC_FORM_ENDPOINT=

# "true" only once the site is live on its final domain with confirmed content.
# While false, every page carries <meta name="robots" content="noindex">.
PUBLIC_ALLOW_INDEXING=false

# Deployment target (normally set by the GitHub Actions workflow).
SITE_URL=https://tony1sosa.github.io
BASE_PATH=/lili_web
