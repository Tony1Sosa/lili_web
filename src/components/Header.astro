---
import type { Lang } from '../i18n/ui';
import { localePath, useTranslations } from '../i18n/utils';
import { url } from '../lib/url';
import { company } from '../data/company';
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;
const t = useTranslations(lang);

const links = [
  { href: localePath(lang, 'products'), label: t('nav.products') },
  { href: localePath(lang, 'projects'), label: t('nav.projects') },
  { href: localePath(lang, 'manufacturing'), label: t('nav.manufacturing') },
  { href: localePath(lang, 'about'), label: t('nav.about') },
  { href: localePath(lang, 'contact'), label: t('nav.contact') },
];

const isCurrent = (href: string) => path === href;
const isSection = (href: string) => path.startsWith(href) && path !== href;
---

<header class="site-header" data-header>
  <div class="container site-header__bar">
    <a class="brand" href={url(localePath(lang))}>
      <img
        class="brand__logo"
        src={url(company.logo.src)}
        width={company.logo.width}
        height={company.logo.height}
        alt={company.logo.includesName ? company.brand[lang] : ''}
      />
      <span class:list={['brand__text', { 'visually-hidden': company.logo.includesName }]}>
        <span class="brand__name">{company.brand[lang]}</span>
        <span class="brand__sub">{company.metalworkBrand}</span>
      </span>
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__icon nav-toggle__icon--open"><Icon name="menu" /></span>
      <span class="nav-toggle__icon nav-toggle__icon--close"><Icon name="close" /></span>
      <span class="nav-toggle__label">{t('header.menu')}</span>
    </button>

    <div class="site-nav" id="site-nav" data-nav>
      <nav aria-label={t('nav.main')}>
        <ul class="site-nav__list">
          {
            links.map((link) => (
              <li>
                <a
                  href={url(link.href)}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={{ 'is-section': isSection(link.href) }}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="site-nav__actions">
        <LanguageSwitcher lang={lang} path={path} />
        <a class="btn site-nav__cta" href={url(localePath(lang, 'contact')) + '#quote'}>
          {t('cta.quote')}
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(32 35 38 / 0.97);
    color: var(--c-paper);
    border-bottom: 1px solid var(--c-ink-3);
  }

  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: rgb(32 35 38 / 0.9);
      backdrop-filter: blur(8px);
    }
  }

  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: var(--header-h);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-right: auto;
    color: inherit;
    text-decoration: none;
    min-width: 0;
  }

  .brand__logo {
    flex: none;
    height: 2.5rem;
    width: auto;
  }

  .brand__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    min-width: 0;
  }

  .brand__name {
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.01em;
  }

  .brand__sub {
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c-steel);
  }

  .site-nav__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__list a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0 0.75rem;
    color: var(--c-paper);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .site-nav__list a::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.35rem;
    height: 2px;
    background: var(--c-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .site-nav__list a:hover::after,
  .site-nav__list a[aria-current='page']::after,
  .site-nav__list a.is-section::after {
    transform: scaleX(1);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-toggle {
    display: none;
  }

  /* Desktop */
  @media (min-width: 64em) {
    .site-nav {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
  }

  /* Mobile & tablet */
  @media (max-width: 63.99em) {
    .brand__name {
      font-size: 0.9375rem;
    }

    :global(.js) .nav-toggle {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      min-height: 2.75rem;
      padding: 0 0.75rem;
      border: 1px solid var(--c-ink-3);
      border-radius: var(--radius);
      background: transparent;
      color: var(--c-paper);
      font-weight: 600;
      font-size: var(--fs-sm);
      cursor: pointer;
    }

    .nav-toggle__icon {
      display: inline-flex;
    }

    .nav-toggle__icon :global(svg) {
      width: 1.375rem;
      height: 1.375rem;
    }

    .nav-toggle__icon--close,
    .nav-toggle[aria-expanded='true'] .nav-toggle__icon--open {
      display: none;
    }

    .nav-toggle[aria-expanded='true'] .nav-toggle__icon--close {
      display: inline-flex;
    }

    /* Without JavaScript the navigation is simply shown below the bar. */
    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--c-ink);
      border-bottom: 1px solid var(--c-ink-3);
      padding: var(--space-3) var(--gutter) var(--space-5);
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
    }

    :global(html:not(.js)) .site-nav {
      position: static;
      padding-inline: 0;
    }

    :global(.js) .site-nav {
      display: none;
    }

    :global(.js) .site-nav.is-open {
      display: block;
    }

    .site-nav__list {
      flex-direction: column;
    }

    .site-nav__list a {
      min-height: 3.25rem;
      padding: 0;
      font-size: var(--fs-lg);
      border-bottom: 1px solid var(--c-ink-3);
    }

    .site-nav__list a::after {
      left: 0;
      right: auto;
      width: 2rem;
      bottom: 0.5rem;
    }

    .site-nav__actions {
      flex-wrap: wrap;
      justify-content: space-between;
      margin-top: var(--space-5);
    }

    .site-nav__cta {
      flex: 1 1 12rem;
    }
  }

  @media (max-width: 26em) {
    .brand__sub {
      display: none;
    }

    /* Icon-only on narrow phones; the label stays available to screen readers. */
    .nav-toggle__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
