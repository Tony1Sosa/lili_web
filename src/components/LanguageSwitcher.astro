---
import { LANGS, langMeta, type Lang } from '../i18n/ui';
import { translatePath, useTranslations } from '../i18n/utils';
import { url } from '../lib/url';

interface Props {
  lang: Lang;
  path: string;
  variant?: 'header' | 'footer';
}

const { lang, path, variant = 'header' } = Astro.props;
const t = useTranslations(lang);
const Wrapper = variant === 'header' ? 'nav' : 'div';
---

{/* Only the header copy is a navigation landmark; the footer copy is a plain list. */}
<Wrapper class:list={['lang-switch', `lang-switch--${variant}`]} aria-label={variant === 'header' ? t('header.language') : undefined}>
  <ul>
    {
      LANGS.map((l) => (
        <li>
          <a
            href={url(translatePath(path, l))}
            hreflang={langMeta[l].htmlLang}
            lang={langMeta[l].htmlLang}
            aria-current={l === lang ? 'true' : undefined}
            data-set-lang={l}
            title={l === lang ? undefined : langMeta[l].name}
          >
            <span aria-hidden="true">{langMeta[l].short}</span>
            <span class="visually-hidden">{langMeta[l].name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Wrapper>

<style>
  .lang-switch ul {
    display: flex;
    gap: 2px;
    margin: 0;
    padding: 2px;
    list-style: none;
    border: 1px solid var(--c-ink-3);
    border-radius: var(--radius);
  }

  .lang-switch a {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.5rem;
    padding: 0 0.5rem;
    border-radius: 2px;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--c-steel);
    text-decoration: none;
  }

  .lang-switch a:hover {
    color: var(--c-paper);
    background: var(--c-ink-2);
  }

  .lang-switch a[aria-current='true'] {
    background: var(--c-paper);
    color: var(--c-ink);
  }
</style>
