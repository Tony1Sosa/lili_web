---
import type { Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';
import { url } from '../lib/url';

interface Crumb {
  label: string;
  /** Site-relative path of a parent page. */
  href: string;
}

interface Props {
  lang: Lang;
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: Crumb[];
}

const { lang, title, eyebrow, lead, crumbs = [] } = Astro.props;
const t = useTranslations(lang);
const trail: Crumb[] = [{ label: t('crumb.home'), href: localePath(lang) }, ...crumbs];

---

<section class="page-header blueprint on-dark">
  <div class="container">
    <nav class="crumbs" aria-label={t('crumb.label')}>
      <ol>
        {
          trail.map((c) => (
            <li>
              <a href={url(c.href)}>{c.label}</a>
            </li>
          ))
        }
        <li><span aria-current="page">{title}</span></li>
      </ol>
    </nav>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-header {
    color: var(--c-paper);
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
    border-bottom: 1px solid var(--c-ink-3);
  }

  .page-header h1 {
    max-width: 22ch;
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.5rem);
  }

  .page-header .lead {
    color: var(--c-steel);
    margin-bottom: 0;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.04em;
    color: var(--c-steel);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: 0.5rem;
    color: var(--c-ink-3);
  }

  .crumbs a {
    color: var(--c-steel);
  }

  .crumbs a:hover {
    color: var(--c-paper);
  }

  .crumbs [aria-current='page'] {
    color: var(--c-paper);
  }
</style>
