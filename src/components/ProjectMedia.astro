---
/**
 * A project's cover photo, or a clearly-labelled placeholder when no photo has been
 * uploaded yet. Placeholders are drawings, never stock photos posing as company work.
 */
import { Picture } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { Project } from '../lib/content';
import { categories } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  lang: Lang;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  /** Decorative inside a link that already has the project title. */
  decorative?: boolean;
}

const {
  project,
  lang,
  sizes = '(min-width: 76rem) 24rem, (min-width: 40rem) 45vw, 100vw',
  loading = 'lazy',
  decorative = false,
} = Astro.props;
const t = useTranslations(lang);
const cover = project.cover;
const icon = categories[project.data.category].icon;
---

<div class="media">
  {
    cover ? (
      <Picture
        src={cover.image}
        alt={decorative ? '' : cover.alt[lang]}
        widths={[400, 640, 960, 1280]}
        sizes={sizes}
        formats={['avif', 'webp']}
        loading={loading}
        decoding="async"
        fetchpriority={loading === 'eager' ? 'high' : undefined}
      />
    ) : (
      <div class="media__placeholder" role={decorative ? undefined : 'img'} aria-label={decorative ? undefined : `${project.data.title[lang]} — ${t('projects.photosPending')}`}>
        <Icon name={icon} size={72} strokeWidth={1.1} />
        <span class="media__label" aria-hidden={decorative ? 'true' : undefined}>
          <Icon name="camera" size={14} strokeWidth={2} />
          {t('projects.photosPending')}
        </span>
      </div>
    )
  }
</div>

<style>
  .media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--c-line);
  }

  .media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .media__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: #8e959c;
    background-color: #eceef0;
    background-image:
      linear-gradient(rgb(32 35 38 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(32 35 38 / 0.06) 1px, transparent 1px);
    background-size: 24px 24px;
    background-position: center;
  }

  .media__placeholder > :global(svg) {
    width: 30%;
    height: auto;
    max-width: 6rem;
  }

  .media__label {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem;
    background: var(--c-white);
    border: 1px solid var(--c-line-2);
    border-radius: 2px;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--c-muted);
  }
</style>
