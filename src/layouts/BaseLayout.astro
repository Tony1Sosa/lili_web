---
import '@fontsource-variable/manrope';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import type { Lang } from '../i18n/ui';
import { langMeta } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { stripBase } from '../lib/url';
import { company } from '../data/company';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  /** Page title without the brand suffix. Omit on the homepage. */
  title?: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  alternates?: boolean;
  jsonLd?: object[];
  /** Override the detected path (used by the 404 page). */
  path?: string;
}

const { lang, title, description, image, imageAlt, noindex, alternates, jsonLd, path: pathOverride } = Astro.props;
const t = useTranslations(lang);
const path = pathOverride ?? stripBase(Astro.url.pathname);
const brand = company.brand[lang];
const fullTitle = title ? `${title} | ${brand}` : `${brand} — ${company.metalworkBrand}`;
---

<!doctype html>
<html lang={langMeta[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#202326" />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Seo
      lang={lang}
      title={fullTitle}
      description={description}
      path={path}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
      alternates={alternates}
      jsonLd={jsonLd}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('header.skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} path={path} />

    <script>
      // Mobile navigation
      const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      if (toggle && nav) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('is-open', open);
        };
        toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
        window.matchMedia('(min-width: 64em)').addEventListener('change', (e) => e.matches && setOpen(false));
      }

      // Remember an explicit language choice (used by the root language redirect).
      document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((link) => {
        link.addEventListener('click', () => {
          try {
            localStorage.setItem('site-lang', link.dataset.setLang ?? '');
          } catch {
            /* storage unavailable (private mode) — ignore */
          }
        });
      });

      // Subtle reveal-on-scroll; content stays visible if the observer is unavailable.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
